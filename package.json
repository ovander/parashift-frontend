    "@primevue/themes": "^4.5.4",
    "@rollup/rollup-linux-arm64-gnu": "^4.60.1",
    "@vueuse/core": "^14.2.1",
    "axios": "^1.13.6",
    "pinia": "^3.0.4",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.4",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.30",
