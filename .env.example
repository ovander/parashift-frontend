# The SPA calls its own origin only (/api, /bff, /auth) and has no Socrate
# setting: sign-in runs on the backend. `npm run dev` proxies those paths to
# PARASHIFT_API (a shell variable, not VITE_*), default http://localhost:8080.
VITE_DEFAULT_LOCALE=en
# FullCalendar scheduler license key.
# Use 'CC-Attribution-NonCommercial-NoDerivatives' for non-commercial / internal use.
# Replace with your commercial key from https://fullcalendar.io/pricing for production.
VITE_FULLCALENDAR_LICENSE_KEY=CC-Attribution-NonCommercial-NoDerivatives
